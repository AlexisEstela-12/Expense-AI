# Allow only the runtime source tree and hashed Python requirements.
**
!Dockerfile
!.dockerignore
!requirements.lock
!main.py
!api/
!api/**
!chat/
!chat/**
!core/
!core/**
!db/
!db/**
!llm/
!llm/**
!schemas/
!schemas/**
!services/
!services/**

# Defense in depth for anything under the allowed directories.
**/.env*
**/*credentials*
**/*secrets*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.db*
**/*.sqlite*
**/*.bak
**/*.log
**/__pycache__/
**/*.py[cod]
**/.venv/
**/tests/
**/test_*.py
