  "components": {
    "schemas": {
      "BalanceChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "BalanceChatRequest"
      },
      "BalanceChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "financial_data": {
            "anyOf": [
              {
                "additionalProperties": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Financial Data"
          },
          "explanation_source": {
            "type": "string",
            "enum": [
              "llm",
              "fallback",
              "unsupported"
            ],
            "title": "Explanation Source"
          },
          "explanation_reason": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "configuration_error",
                  "authentication_error",
                  "rate_limit_error",
                  "timeout",
                  "connection_error",
                  "provider_error",
                  "provider_unavailable",
                  "empty_response",
                  "validation_rejected_digits",
                  "internal_error",
                  "unsupported"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Reason",
            "default": "unsupported"
          },
          "diagnostic_id": {
            "type": "string",
            "title": "Diagnostic Id"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "financial_data",
          "explanation_source"
        ],
        "title": "BalanceChatResponse"
      },
      "BudgetIn": {
        "properties": {
          "month": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
            "title": "Month"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Category"
          },
          "currency": {
            "$ref": "#/components/schemas/Money"
          },
          "limit_amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Limit Amount"
          }
        },
        "type": "object",
        "required": [
          "month",
          "category",
          "currency",
          "limit_amount"
        ],
        "title": "BudgetIn"
      },
      "CategoryIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "pattern": "^(income|expense|reimbursement)$",
            "title": "Kind"
          }
        },
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "title": "CategoryIn"
      },
      "ExchangeIn": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "from_currency": {
            "$ref": "#/components/schemas/Money"
          },
          "amount_out": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount Out"
          },
          "amount_in": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount In"
          }
        },
        "type": "object",
        "required": [
          "date",
          "from_currency",
          "amount_out",
          "amount_in"
        ],
        "title": "ExchangeIn"
      },
      "FinancialToolsRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "FinancialToolsRequest"
      },
      "FinancialToolsResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "financial_data": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Financial Data"
          },
          "explanation_source": {
            "type": "string",
            "enum": [
              "llm",
              "fallback",
              "unsupported"
            ],
            "title": "Explanation Source"
          },
          "explanation_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation Reason"
          },
          "diagnostic_id": {
            "type": "string",
            "title": "Diagnostic Id"
          },
          "tool_executed": {
            "type": "boolean",
            "title": "Tool Executed"
          },
          "tool_name": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "get_balances",
                  "get_spending_summary",
                  "get_spending_by_category",
                  "get_budget_status"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Name"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "financial_data",
          "explanation_source",
          "explanation_reason",
          "diagnostic_id",
          "tool_executed",
          "tool_name"
        ],
        "title": "FinancialToolsResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Money": {
        "type": "string",
        "enum": [
          "PEN",
          "USD"
        ],
        "title": "Money"
      },
      "MovementIn": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "kind": {
            "type": "string",
            "pattern": "^(income|expense|reimbursement)$",
            "title": "Kind"
          },
          "currency": {
            "$ref": "#/components/schemas/Money"
          },
          "amount": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,17}0*$)\\d{0,14}\\.\\d{0,2}0*$)"
              }
            ],
            "title": "Amount"
          },
          "category": {
            "type": "string",
            "maxLength": 80,
